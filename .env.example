# =============================================================================
# BUGSITO — Variables de Entorno y Secretos de LLMs (Genkit)
# =============================================================================
# Copia este archivo a ~/.config/bugsito/.env (chmod 600).
# Si usas el ecosistema dotfiles (~/dotfiles/.env), Bugsito también puede leer
# tus variables desde allí automáticamente.

# Modo de operación de LLM en Genkit:
#   "local" -> Usa un servidor LLM por IP/red local o Tailscale (ej. Ollama, vLLM, LM Studio)
#   "token" -> Usa un proveedor en la nube por API Key / Token (Gemini, OpenAI, Groq, DeepSeek, Anthropic)
#   "auto"  -> Intenta el proveedor principal y hace fallback automático si no responde
export BUGSITO_LLM_MODE="auto"

# Perfil activo definido en config.toml (ej. "mac-ollama", "local-ollama", "gemini", "openai", "groq")
export BUGSITO_LLM_PROFILE="mac-ollama"

# --- MODO LOCAL POR IP (Ollama / OpenAI-compatible en LAN o Tailscale) ---
# Si no se define BUGSITO_OLLAMA_HOST y existe CONTEXT_HUB_URL en ~/dotfiles/.env,
# Bugsito deduce la IP de la Mac Mini automáticamente.
export BUGSITO_OLLAMA_HOST="http://127.0.0.1:11434"
export BUGSITO_OLLAMA_MODEL="llama3.1:8b"

# --- MODO POR TOKEN (Proveedores Cloud gestionados con Genkit) ---
export GEMINI_API_KEY=""
export OPENAI_API_KEY=""
export GROQ_API_KEY=""
export DEEPSEEK_API_KEY=""
export ANTHROPIC_API_KEY=""

# --- SERVIDOR GENKIT FLOWS (Opcional) ---
# Si levantas el servidor local de Genkit (`bugsito genkit-serve`), Bugsito
# enruta las consultas a través de los flujos de Genkit en este puerto:
export BUGSITO_GENKIT_URL="http://127.0.0.1:3400"
